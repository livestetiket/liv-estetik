NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/liv-estetik
JWT_SECRET=replace-with-a-long-random-development-secret
ADMIN_EMAIL=admin@livestetik.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin

# console records a simulated attempt in the API log; it does not deliver mail.
# Set smtp and provide the SMTP relay values below for real delivery.
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

CLINIC_NAME=Liv Estetik
CLINIC_PHONE=+251 911 50 40 02
CLINIC_ADDRESS=Bole Road, Snap Plaza 1st Floor, Addis Ababa, Ethiopia
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Set only when scheduled report generation is enabled.
REPORT_CRON_SECRET=
